# Reference ignore rules for deployments using docker/ as the build context.
# The checked-in compose file builds from the repository root, so ../.dockerignore is active.
.git
.github
.env
.env.*
!.env.example
data/
reports/
logs/
tests/
docs/
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.md
!README.md
